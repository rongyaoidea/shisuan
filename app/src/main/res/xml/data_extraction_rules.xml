<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的数据提取规则（云备份 + 换机传输）。
  与 backup_rules.xml 保持同一策略：只包含业务数据库与偏好设置。
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
